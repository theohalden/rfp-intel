# LLM settings for extraction and Q&A.
# OpenAI selected by the user; fill the model ID from your API account.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# gpt-5.4-mini defaults to medium in this app. Leave blank for a model without reasoning.
OPENAI_REASONING_EFFORT=medium

# Reserved for a future Anthropic adapter; currently only OpenAI is implemented.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
